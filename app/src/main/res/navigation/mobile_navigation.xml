<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_picture">


    <fragment
        android:id="@+id/nav_picture"
        android:name="com.fde.gallery3d.ui.picture.PictureListFragment"
        android:label="@string/menu_picture"
        tools:layout="@layout/fragment_picture" />

    <fragment
        android:id="@+id/nav_video"
        android:name="com.fde.gallery3d.ui.video.VideoListFragment"
        android:label="@string/menu_video"
        tools:layout="@layout/fragment_video" />

    <fragment
        android:id="@+id/nav_timeline"
        android:name="com.fde.gallery3d.ui.timeline.TimeLineListFragment"
        android:label="@string/menu_timeline"
        tools:layout="@layout/fragment_timeline" />

    <fragment
        android:id="@+id/nav_collection"
        android:name="com.fde.gallery3d.ui.favorite.FavoriteFragment"
        android:label="@string/menu_collection"
        tools:layout="@layout/fragment_media_grid" />

    <fragment
        android:id="@+id/nav_category_portrait"
        android:name="com.fde.gallery3d.ui.category.CategoryFragment"
        android:label="@string/category_portrait"
        tools:layout="@layout/fragment_media_grid">
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="PORTRAIT" />
    </fragment>

    <fragment
        android:id="@+id/nav_category_landscape"
        android:name="com.fde.gallery3d.ui.category.CategoryFragment"
        android:label="@string/category_landscape"
        tools:layout="@layout/fragment_media_grid">
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="LANDSCAPE" />
    </fragment>

    <fragment
        android:id="@+id/nav_category_animal"
        android:name="com.fde.gallery3d.ui.category.CategoryFragment"
        android:label="@string/category_animal"
        tools:layout="@layout/fragment_media_grid">
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="ANIMAL" />
    </fragment>

    <fragment
        android:id="@+id/nav_category_food"
        android:name="com.fde.gallery3d.ui.category.CategoryFragment"
        android:label="@string/category_food"
        tools:layout="@layout/fragment_media_grid">
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="FOOD" />
    </fragment>

    <fragment
        android:id="@+id/nav_category_plant"
        android:name="com.fde.gallery3d.ui.category.CategoryFragment"
        android:label="@string/category_plant"
        tools:layout="@layout/fragment_media_grid">
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="PLANT" />
    </fragment>

    <fragment
        android:id="@+id/nav_category_architecture"
        android:name="com.fde.gallery3d.ui.category.CategoryFragment"
        android:label="@string/category_architecture"
        tools:layout="@layout/fragment_media_grid">
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="ARCHITECTURE" />
    </fragment>

    <fragment
        android:id="@+id/nav_category_vehicle"
        android:name="com.fde.gallery3d.ui.category.CategoryFragment"
        android:label="@string/category_vehicle"
        tools:layout="@layout/fragment_media_grid">
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="VEHICLE" />
    </fragment>

    <fragment
        android:id="@+id/nav_trash"
        android:name="com.fde.gallery3d.ui.trash.TrashFragment"
        android:label="@string/menu_trash"
        tools:layout="@layout/fragment_media_grid" />

    <fragment
        android:id="@+id/nav_search"
        android:name="com.fde.gallery3d.ui.search.SearchFragment"
        android:label="@string/menu_search"
        tools:layout="@layout/fragment_media_grid" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.fde.gallery3d.ui.settings.SettingsFragment"
        android:label="@string/menu_settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
