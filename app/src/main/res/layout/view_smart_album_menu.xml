<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <!-- 智能图册 父级菜单 -->
    <LinearLayout
        android:id="@+id/smart_album_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_smart_album_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <ImageView
            android:id="@+id/smart_album_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/menu_smart_album"
            android:src="@drawable/ic_smart_album"
            app:tint="@color/nav_item_icon" />

        <TextView
            android:id="@+id/smart_album_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/menu_smart_album"
            android:textColor="@color/side_text"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/smart_album_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/menu_smart_album"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/side_text" />
    </LinearLayout>

    <!-- 二级子菜单：人像 / 风景 / 美食 -->
    <LinearLayout
        android:id="@+id/smart_album_submenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/smart_album_item_portrait"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_smart_album_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:paddingStart="30dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/category_portrait"
                android:src="@drawable/ic_cat_portrait"
                app:tint="@color/nav_item_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/category_portrait"
                android:textColor="@color/side_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/smart_album_item_landscape"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_smart_album_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:paddingStart="30dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/category_landscape"
                android:src="@drawable/ic_cat_landscape"
                app:tint="@color/nav_item_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/category_landscape"
                android:textColor="@color/side_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/smart_album_item_food"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_smart_album_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:paddingStart="30dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/category_food"
                android:src="@drawable/ic_cat_food"
                app:tint="@color/nav_item_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/category_food"
                android:textColor="@color/side_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
